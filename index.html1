    { day: 'Day 12 · 1/1', type: 'ny', title: '【元旦】元旦初诣 + 藻岩山日本新三大夜景', desc: '睡到自然醒，傍晚乘有轨电车与缆车登顶藻岩山，俯瞰新年第一晚的札幌璀璨雪夜。', couple: '💑 情侣彩蛋：敲响藻岩山顶「幸福之钟（恋人の聖地）」，锁上双人爱情锁。' },
    { day: 'Day 13 · 1/2', type: 'ny', title: '【正月大促】札幌站 JR Tower / 大丸百货抢福袋', desc: '1月2日日本新年首卖（初売り），去札幌站商圈抢户外滑雪品牌、服饰与甜品超值新年福袋。', couple: '💑 情侣彩蛋：一起体验日本新年抢福袋乐趣，逛地下美食街吃热腾腾味噌拉面。' },
    { day: 'Day 14 · 1/3', type: 'ski', title: '【滑雪 Day 7】札幌手稻滑雪场 · 浪漫夜景滑雪收官', desc: '下午进场买 5 小时券或夜场票 (16:00-20:00 仅 ¥2,900)，在灯光雪道下俯瞰札幌百万夜景完成毕业滑。', couple: '💑 情侣彩蛋：夜场灯光雪道极度浪漫，人少雪好，滑完回市区吃庆祝大餐。' },
    { day: 'Day 15 · 1/4', type: 'sight', title: '【自由收尾】札幌啤酒博物馆 + 狸小路伴手礼采购', desc: '利用非跨年优惠日补齐白色恋人、薯条三兄弟等伴手礼，晚上整理打包全部行李箱。', couple: '💑 情侣彩蛋：在札幌啤酒园红砖建筑前合影，品尝限定生啤与烤肉晚餐。' },
    { day: 'Day 16 · 1/5', type: 'ny', title: '札幌 → 新千岁机场逛吃 → 飞回福冈 (FUK)', desc: '退房乘 JR 快速 Airport 提前 2.5 小时抵达新千岁机场，逛国内线 2F/3F 拉面道场与甜品街后飞回福冈。', couple: '💑 情侣彩蛋：在机场买最后一支北海道浓厚牛乳冰淇淋，圆满结束 16 天旅程。' }
  ];

  let reminders = JSON.parse(localStorage.getItem('hk_reminders_v1')) || defaultReminders;

  function setTravelMode(mode) {
    travelMode = mode;
    document.getElementById('btnSolo').classList.toggle('active', mode === 'solo');
    document.getElementById('btnCouple').classList.toggle('active', mode === 'couple');
    document.body.classList.toggle('couple-mode', mode === 'couple');
    document.getElementById('kpiModeLabel').innerText = mode === 'solo' ? '单人总计' : '情侣人均(已均摊)';
    recalc();
  }

  function renderSubsidies() {
    const grid = document.getElementById('subsidyGrid');
    grid.innerHTML = subsidies.map((s, idx) => `
      <div class="subsidy-card ${s.checked ? 'checked' : ''}">
        <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
          <input type="checkbox" ${s.checked ? 'checked' : ''} onchange="toggleSubsidy(${idx})" style="margin-top:4px;">
          <div>
            <strong>${s.name}</strong>
            <div style="color:#15803d;font-weight:700;font-size:13px;margin:2px 0;">预计人均立省：¥${s.saving.toLocaleString()}</div>
            <div style="font-size:12px;color:#0369a1;margin-bottom:4px;">📅 ${s.period}</div>
            <div style="font-size:12px;color:#475569;">${s.desc}</div>
          </div>
        </label>
      </div>
    `).join('');
  }

  function toggleSubsidy(idx) {
    subsidies[idx].checked = !subsidies[idx].checked;
    renderSubsidies();
    recalc();
  }

  function recalc() {
    const hotelName = document.getElementById('hotelNameInput').value || '札幌市区青旅';
    const hotelMode = document.getElementById('hotelModeSelect').value;
    let nightly = Number(document.getElementById('hotelPriceInput').value) || 4500;
    const flight = Number(document.getElementById('flightSelect').value);
    const airportTransfer = Number(document.getElementById('airportTransferSelect').value);
    const skiPlan = document.getElementById('skiPlanSelect').value;

    let hotelTotal = nightly * 15;
    if (hotelMode === 'split') {
      hotelTotal = nightly * 13 + 16000 + 11000;
    }
    if (travelMode === 'couple') {
      hotelTotal = Math.round(hotelTotal * 0.65);
    }

    let skiDays = 6;
    let skiCost = 53500;
    if (skiPlan === '6_private') {
      skiCost = travelMode === 'couple' ? 56000 : 62000;
    } else if (skiPlan === '7_group') {
      skiDays = 7;
      skiCost = 59800;
    }

    const foodAndSight = 44000;
    const saved = subsidies.filter(s => s.checked).reduce((acc, s) => acc + s.saving, 0);
    const grandTotal = Math.max(0, hotelTotal + flight + airportTransfer + skiCost + foodAndSight - saved);

    document.getElementById('kpiHotelName').innerText = hotelName;
    document.getElementById('kpiHotelCost').innerText = '¥' + hotelTotal.toLocaleString();
    document.getElementById('kpiSkiDays').innerText = skiDays;
    document.getElementById('kpiSkiCost').innerText = '¥' + skiCost.toLocaleString();
    document.getElementById('kpiSavedCost').innerText = '-¥' + saved.toLocaleString();
    document.getElementById('kpiTotalJpy').innerText = '¥' + grandTotal.toLocaleString();
    document.getElementById('kpiTotalCny').innerText = `约合 ¥${Math.round(grandTotal * 0.048).toLocaleString()} 人民币 (已扣减政府/学生优惠)`;
  }

  function renderReminders() {
    const simStr = document.getElementById('simDateInput').value;
    const simDate = new Date(simStr + 'T00:00:00');
    const list = document.getElementById('reminderList');
    let urgentAlerts = [];

    list.innerHTML = reminders.map((r, idx) => {
      const dl = new Date(r.deadline + 'T00:00:00');
      const diffDays = Math.ceil((dl - simDate) / (1000 * 60 * 60 * 24));
      let badgeHtml = '';
      let cardClass = 'reminder-card';

      if (diffDays < 0) {
        badgeHtml = `<span class="badge" style="background:#e2e8f0;color:#475569;">已过截止日 (${r.deadline})</span>`;
      } else if (diffDays === 0) {
        badgeHtml = `<span class="badge badge-t1">🚨 今天最后截止！(${r.deadline})</span>`;
        cardClass += ' urgent-1';
        urgentAlerts.push(`【今日截止】${r.title}`);
      } else if (diffDays === 1) {
        badgeHtml = `<span class="badge badge-t1">🔥 T-1 预警：明天截止 (${r.deadline})</span>`;
        cardClass += ' urgent-1';
        urgentAlerts.push(`【提前1天预警】${r.title}`);
      } else if (diffDays === 2) {
        badgeHtml = `<span class="badge badge-t2">⚠️ T-2 预警：还剩 2 天 (${r.deadline})</span>`;
        cardClass += ' urgent-2';
        urgentAlerts.push(`【提前2天预警】${r.title}`);
      } else if (diffDays === 3) {
        badgeHtml = `<span class="badge badge-t3">⏰ T-3 预警：还剩 3 天 (${r.deadline})</span>`;
        cardClass += ' urgent-3';
        urgentAlerts.push(`【提前3天预警】${r.title}`);
      } else {
        badgeHtml = `<span class="badge badge-ok">距截止还有 ${diffDays} 天 (${r.deadline})</span>`;
      }

      return `
        <div class="${cardClass}">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
            <strong style="font-size:15px;">${r.title}</strong>
            ${badgeHtml}
          </div>
          <div class="step-grid">
            <div class="step-box">
              <label>
                <input type="checkbox" ${r.done.t3 ? 'checked' : ''} onchange="toggleRemStep(${idx}, 't3')">
                <span><strong>提前 3 天 (T-3)：</strong>${r.steps.t3}</span>
              </label>
            </div>
            <div class="step-box">
              <label>
                <input type="checkbox" ${r.done.t2 ? 'checked' : ''} onchange="toggleRemStep(${idx}, 't2')">
                <span><strong>提前 2 天 (T-2)：</strong>${r.steps.t2}</span>
              </label>
            </div>
            <div class="step-box">
              <label>
                <input type="checkbox" ${r.done.t1 ? 'checked' : ''} onchange="toggleRemStep(${idx}, 't1')">
                <span><strong>提前 1 天 (T-1)：</strong>${r.steps.t1}</span>
              </label>
            </div>
          </div>
        </div>
      `;
    }).join('');

    const banner = document.getElementById('urgentBannerText');
    if (urgentAlerts.length > 0) {
      banner.innerText = '🚨 紧急价格订阅预警：' + urgentAlerts.join(' ｜ ');
    } else {
      banner.innerText = `✅ 当前模拟日期 (${simStr}) 暂无 T-3/T-2/T-1 紧急到期项，可切换沙盘日期测试提醒`;
    }
  }

  function toggleRemStep(idx, step) {
    reminders[idx].done[step] = !reminders[idx].done[step];
    localStorage.setItem('hk_reminders_v1', JSON.stringify(reminders));
  }

  function addCustomReminder() {
    const title = document.getElementById('newRemTitle').value.trim();
    const deadline = document.getElementById('newRemDate').value;
    const note = document.getElementById('newRemNote').value.trim() || '核对价格与预约名额';
    if (!title || !deadline) return alert('请填写提醒事项名称和截止日期');
    reminders.unshift({
      id: 'rem_' + Date.now(),
      title,
      deadline,
      steps: {
        t3: `提前3天准备：查阅「${title}」最新规则（${note}）`,
        t2: `提前2天核对：确认支付方式与出行日期匹配`,
        t1: `提前1天锁单：完成最终预订与截屏保存凭证`
      },
      done: { t3: false, t2: false, t1: false }
    });
    localStorage.setItem('hk_reminders_v1', JSON.stringify(reminders));
    document.getElementById('newRemTitle').value = '';
    renderReminders();
  }

  function requestNotif() {
    if (!('Notification' in window)) return alert('当前浏览器不支持系统桌面通知');
    Notification.requestPermission().then(p => {
      if (p === 'granted') {
        new Notification('北海道行程提醒已开启', { body: '将在每个价格订阅截止前 3 天、2 天、1 天为您发送阶梯预警！' });
      }
    });
  }

  function exportICS() {
    let lines = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Hokkaido Ski Trip 2026//CN'
    ];
    reminders.forEach(r => {
      const dt = r.deadline.replace(/-/g, '');
      lines.push(
        'BEGIN:VEVENT',
        `UID:${r.id}@hokkaido2026`,
        `DTSTAMP:${dt}T090000Z`,
        `DTSTART;VALUE=DATE:${dt}`,
        `SUMMARY:【截止日】${r.title}`,
        `DESCRIPTION:T-3天: ${r.steps.t3}\\nT-2天: ${r.steps.t2}\\nT-1天: ${r.steps.t1}`,
        'BEGIN:VALARM',
        'TRIGGER:-P3D',
        'ACTION:DISPLAY',
        `DESCRIPTION:提前3天提醒：${r.title}`,
        'END:VALARM',
        'BEGIN:VALARM',
        'TRIGGER:-P2D',
        'ACTION:DISPLAY',
        `DESCRIPTION:提前2天提醒：${r.title}`,
        'END:VALARM',
        'BEGIN:VALARM',
        'TRIGGER:-P1D',
        'ACTION:DISPLAY',
        `DESCRIPTION:提前1天最后提醒：${r.title}`,
        'END:VALARM',
        'END:VEVENT'
      );
    });
    lines.push('END:VCALENDAR');
    const blob = new Blob([lines.join('\r\n')], { type: 'text/calendar;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'Hokkaido_2026_321_Reminders.ics';
    a.click();
  }

  function renderTimeline(filter = 'all') {
    const container = document.getElementById('timelineContainer');
    const filtered = filter === 'all' ? itineraryDays : itineraryDays.filter(d => d.type === filter);
    container.innerHTML = filtered.map(d => `
      <div class="timeline-item">
        <div class="day-tag">${d.day}</div>
        <div>
          <strong>${d.title}</strong>
          <div style="font-size:14px;color:#334155;margin-top:2px;">${d.desc}</div>
          <div class="couple-note">${d.couple}</div>
        </div>
      </div>
    `).join('');
  }

  function filterDays(type, btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderTimeline(type);
  }

  function saveState() {
    localStorage.setItem('hk_reminders_v1', JSON.stringify(reminders));
    alert('✅ 当前住宿、交通、补贴及 3-2-1 提醒进度已保存到浏览器本地！');
  }

  renderSubsidies();
  renderReminders();
  renderTimeline();
  recalc();
</script>
</body>
</html>
